# Skopiuj ten plik jako ".env" i uzupełnij (albo uruchom: npm run setup)

# Token bota: Discord Developer Portal -> Twoja aplikacja -> Bot -> Reset Token
DISCORD_TOKEN=

# ID aplikacji: Developer Portal -> General Information -> Application ID
CLIENT_ID=

# (opcjonalnie) ID Twojego serwera – komendy pojawią się od razu.
# Bez tego rejestrują się globalnie i Discord może je pokazać dopiero po ok. godzinie.
GUILD_ID=

# (opcjonalnie) Twoje ID użytkownika (lub kilka po przecinku) – dostęp do komendy /admin
OWNER_IDS=

# (opcjonalnie) ID kanału, na którym bot ogłasza wyniki codziennej loterii
LOTTERY_CHANNEL_ID=

# (opcjonalnie) Prefiks komend tekstowych, domyślnie "!" (np. !saldo, !moneta 100 orzel).
# Wymaga włączenia MESSAGE CONTENT INTENT w Developer Portal -> Bot. Bez niego bot działa tylko na komendach /
PREFIX=!
# Ustaw na false, żeby wyłączyć komendy z prefiksem
ENABLE_PREFIX=true
